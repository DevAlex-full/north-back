# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT
# IMPORTANTE: JWT_SECRET e JWT_REFRESH_SECRET devem ser valores DIFERENTES entre si.
# O access token é assinado com JWT_SECRET; o refresh token é assinado
# separadamente com JWT_REFRESH_SECRET (via biblioteca jsonwebtoken).
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-and-different-from-jwt-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="*"


SEED_USER_EMAIL="alex@north.app"
SEED_USER_PASSWORD="change-me"

# Fase 5.4 — Integração North SDR (n8n) → North App
# Opcionais: se ausentes, o servidor sobe normalmente; só a rota
# POST /api/v1/webhooks/north-sdr/leads responde 503 até serem definidas.
# NORTH_SDR_WEBHOOK_API_KEY: segredo compartilhado com o n8n (header x-api-key).
#   Gere um valor aleatório forte — nunca reutilize o N8N_WEBHOOK_API_KEY do north-SDR-Back.
# NORTH_SDR_TARGET_USER_ID: id do usuário North App que recebe os leads (ambiente single-user).
NORTH_SDR_WEBHOOK_API_KEY="change-me-generate-a-strong-random-secret"
NORTH_SDR_TARGET_USER_ID="cuid-do-seu-usuario-no-north-app"